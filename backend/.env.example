# Copy to .env and fill in. Never commit .env.

# MySQL 8 (create the database first, see schema.sql)
DATABASE_URL=mysql+pymysql://c2c_user:CHANGE_ME@127.0.0.1:3306/click2clean?charset=utf8mb4

# Long random string, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# First admin account, created on startup if it doesn't exist yet.
# Password must be at least 10 characters. Remove these two lines afterwards if you like.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional portal email for the same seeded admin account.
ADMIN_EMAIL=admin@localhost

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Where uploaded photos are stored (relative to the backend folder)
UPLOAD_DIR=uploads
